# Copy to .env and fill in the keys. `pnpm dev` refuses to start while a setting below is missing or malformed.
# Real environment variables override this file.

# Postgres connection; must be postgres:// or postgresql://. Local default matches the compose file (#5).
DATABASE_URL=postgres://lombard:lombard-dev@127.0.0.1:5432/lombard

# Claude API key (required). Never commit a real key.
ANTHROPIC_API_KEY=
# Empty means the real Claude API; set it to point at the HTTP model fake, e.g. http://127.0.0.1:4010.
ANTHROPIC_BASE_URL=

# Voyage AI embeddings key (required). Never commit a real key.
VOYAGE_API_KEY=
# Empty falls back to this default.
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
